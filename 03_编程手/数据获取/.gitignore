# 本工具产生的数据、缓存、日志不入库；配置和代码入库。
data/raw/*
# 事件目录的原始 API 响应很小，保留以便 batch 7 可复现。
!data/raw/event_catalog/
!data/raw/event_catalog/**
# CHIRPS 原始日栅格约 70 MB，不入库；保留 processed 日值表与来源 URL。
data/raw/event_catalog/chirps/
data/cache/*
data/tables/*
data/runs/*
data/manual/*
data/tpdc_files/*
data/manifest.jsonl
data/meta/errors/*
logs/*
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/tables/.gitkeep
!data/reports/.gitkeep
!data/runs/.gitkeep
!data/meta/errors/.gitkeep
!data/manual/.gitkeep
!data/tpdc_files/.gitkeep
!logs/.gitkeep

__pycache__/
*.pyc
.venv/
tmpjjptl13k/

# 根仓库 .gitignore 默认忽略 *.tif；processed 基线里的 GeoTIFF 需要入库。
!data/processed/**/*.tif
